{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/affinity-map.schema.json",
  "title": "Affinity Synthesis Map",
  "type": "object",
  "required": [
    "format",
    "version",
    "cards",
    "groups"
  ],
  "properties": {
    "format": {
      "const": "affinity-map"
    },
    "version": {
      "type": "string"
    },
    "subject": {
      "type": "object",
      "properties": {
        "question": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "ref": {
            "type": "string"
          },
          "provenance": {
            "type": "string"
          },
          "discovery_route": {
            "type": "string"
          },
          "independence_note": {
            "type": "string"
          },
          "input_status": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "cards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "preservation_note": {
            "type": "string"
          },
          "derivation_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "input_status": {
            "type": "string"
          },
          "cross_field_trace": {
            "type": "object",
            "properties": {
              "target_refs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "framework_refs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "preserved_from_target": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "preserved_from_framework": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "negated_or_revised": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "newly_recomposed": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "note": {
                "type": "string"
              }
            },
            "additionalProperties": true
          },
          "catalytic_trace": {
            "type": "object",
            "properties": {
              "frameworks": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "operations": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "selection_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "locations": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "as_if": {
                "type": "string"
              },
              "note": {
                "type": "string"
              },
              "yield_kinds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "target_responses": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "target_response_refs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "target_return_audits": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "state",
                    "basis_refs"
                  ],
                  "properties": {
                    "state": {
                      "type": "string",
                      "minLength": 1
                    },
                    "basis_refs": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string"
                      }
                    },
                    "note": {
                      "type": "string"
                    },
                    "next_checks": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "source_type": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": true
                }
              },
              "living_lab_delta_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "living_lab_round_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "pre_contact_relations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "state",
                    "source_type",
                    "basis_refs"
                  ],
                  "properties": {
                    "state": {
                      "type": "string",
                      "minLength": 1
                    },
                    "source_type": {
                      "type": "string",
                      "minLength": 1
                    },
                    "basis_refs": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "uniqueItems": true
                    },
                    "statement": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": true
                }
              },
              "user_dispositions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "state"
                  ],
                  "properties": {
                    "state": {
                      "type": "string",
                      "minLength": 1
                    },
                    "source_ref": {
                      "type": "string"
                    },
                    "notes": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": true
                }
              },
              "living_lab_artifact_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "members"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "display_label": {
            "type": "string"
          },
          "members": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "preserved_differences": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "transformation_audit": {
            "type": "object",
            "properties": {
              "inherited": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "emergent": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "residual": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "resonances": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "from",
          "to",
          "note"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "display_label": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "from",
          "to",
          "direction",
          "predicate"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "direction": {
            "type": "string",
            "enum": [
              "directed",
              "reciprocal",
              "unspecified"
            ]
          },
          "predicate": {
            "type": "string"
          },
          "display_label": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "basis": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "note": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "narratives": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "display_label": {
            "type": "string"
          },
          "basis": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "state": {
            "type": "string"
          },
          "transformation_audit": {
            "type": "object",
            "properties": {
              "inherited": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "emergent": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "residual": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "residuals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "handling": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "arises_from": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "candidate_relation_between": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 2,
            "maxItems": 2,
            "uniqueItems": true
          },
          "would_clarify_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "handling": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "display_label": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "handoff": {
      "type": "object",
      "properties": {
        "semantic_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "residual_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "source_refs_to_preserve": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "next_check_candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "text"
            ],
            "properties": {
              "text": {
                "type": "string"
              },
              "refs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "status": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        },
        "do_not_assume": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "layout": {
      "type": "object",
      "properties": {
        "projection": {
          "type": "string"
        },
        "positions": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "x",
              "y"
            ],
            "properties": {
              "x": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
