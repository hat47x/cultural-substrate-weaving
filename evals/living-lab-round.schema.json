{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hat47x/cultural-substrate-weaving/evals/living-lab-round.schema.json",
  "title": "Cultural Substrate Weaving Web Chat Living Lab Round",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "sourced_statement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_type",
        "statement"
      ],
      "properties": {
        "source_type": {
          "enum": [
            "user",
            "ai",
            "external",
            "mixed",
            "unknown"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "value",
        "source_ref"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "unit": {
          "type": "string"
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "target_return": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "source_type",
        "evidence_refs"
      ],
      "properties": {
        "state": {
          "enum": [
            "not_checked",
            "unresolved",
            "target_supported",
            "target_weakened",
            "target_rejected",
            "not_applicable"
          ]
        },
        "source_type": {
          "enum": [
            "user",
            "ai",
            "external",
            "mixed",
            "unknown"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "statement": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "unresolved",
                  "target_supported",
                  "target_weakened",
                  "target_rejected"
                ]
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "evidence_refs": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "user_disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "enum": [
            "not_observed",
            "adopted",
            "modified",
            "withdrawn"
          ]
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "adopted",
                  "modified",
                  "withdrawn"
                ]
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "source_ref"
            ]
          }
        }
      ]
    },
    "artifact_trace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_ref",
        "origin",
        "target_return"
      ],
      "properties": {
        "artifact_ref": {
          "type": "string",
          "minLength": 1
        },
        "origin": {
          "enum": [
            "target_only",
            "framework_generated",
            "cross_field_emergent",
            "mixed"
          ]
        },
        "framework_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "operation_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "target_return": {
          "$ref": "#/$defs/target_return"
        },
        "user_disposition": {
          "$ref": "#/$defs/user_disposition"
        },
        "notes": {
          "type": "string"
        },
        "selection_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "origin": {
                "enum": [
                  "framework_generated",
                  "cross_field_emergent",
                  "mixed"
                ]
              }
            },
            "required": [
              "origin"
            ]
          },
          "then": {
            "required": [
              "framework_refs"
            ],
            "properties": {
              "framework_refs": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "catalytic_delta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "delta_ref",
        "kind",
        "statement",
        "framework_refs",
        "target_return"
      ],
      "properties": {
        "delta_ref": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "question",
            "distinction",
            "relation-or-transition",
            "falsifier-or-observation",
            "residual",
            "framework-specific-scaffold"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "framework_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "selection_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "operation_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "artifact_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "target_return": {
          "$ref": "#/$defs/target_return"
        },
        "user_disposition": {
          "$ref": "#/$defs/user_disposition"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  },
  "required": [
    "schema_version",
    "round_id",
    "case_id",
    "mode",
    "observed_at",
    "task",
    "activation_scope",
    "framework_contacts",
    "artifacts",
    "residuals",
    "reopening_conditions"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2"
    },
    "round_id": {
      "type": "string",
      "pattern": "^round-[A-Za-z0-9._-]+$"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "natural_work",
        "paired_check"
      ]
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "model_label": {
          "type": "string"
        },
        "product_mode": {
          "type": "string"
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "type": "string"
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "constraints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourced_statement"
          }
        }
      }
    },
    "material_delta_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "invocation": {
      "enum": [
        "none",
        "implicit",
        "explicit"
      ]
    },
    "activation_scope": {
      "enum": [
        "non_activation",
        "limited_use",
        "exploratory_use"
      ]
    },
    "unloaded_framework_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "framework",
          "reason",
          "disposition"
        ],
        "properties": {
          "framework": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "disposition": {
            "enum": [
              "rejected",
              "deferred"
            ]
          },
          "stop_reason": {
            "type": "string"
          }
        }
      }
    },
    "framework_contacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "framework",
          "depth",
          "use"
        ],
        "properties": {
          "framework": {
            "type": "string",
            "minLength": 1
          },
          "depth": {
            "enum": [
              "probe",
              "preview",
              "full",
              "enacted"
            ]
          },
          "use": {
            "enum": [
              "exploration",
              "attribution"
            ]
          },
          "notes": {
            "type": "string"
          },
          "selection_ref": {
            "type": "string",
            "minLength": 1
          },
          "operations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      }
    },
    "kj_snapshot_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "residuals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sourced_statement"
      }
    },
    "reopening_conditions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sourced_statement"
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline_chat_ref",
        "treatment_chat_ref"
      ],
      "properties": {
        "baseline_chat_ref": {
          "type": "string",
          "minLength": 1
        },
        "treatment_chat_ref": {
          "type": "string",
          "minLength": 1
        },
        "evaluator_chat_ref": {
          "type": "string"
        },
        "run_order": {
          "enum": [
            "baseline_first",
            "treatment_first",
            "parallel_or_unknown"
          ]
        },
        "observed_differences": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "measurements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/measurement"
          }
        },
        "interpretations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourced_statement"
          }
        }
      }
    },
    "interpretations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sourced_statement"
      }
    },
    "notes": {
      "type": "string"
    },
    "artifact_traces": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact_trace"
      }
    },
    "catalytic_deltas": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/catalytic_delta"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "paired_check"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "required": [
          "comparison"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "activation_scope": {
            "const": "non_activation"
          }
        },
        "required": [
          "activation_scope"
        ]
      },
      "then": {
        "properties": {
          "framework_contacts": {
            "maxItems": 0
          },
          "catalytic_deltas": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
