  "manifestVersion": "1.28",
  "version": "{{VERSION}}",
  "id": "${{M365_APP_ID}}",
  "developer": {
    "name": "${{DEVELOPER_NAME}}",
    "websiteUrl": "${{DEVELOPER_WEBSITE_URL}}",
    "privacyUrl": "${{PRIVACY_URL}}",
